---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SectionBlock from "../components/SectionBlock.astro";
import ArtifactGrid from "../components/ArtifactGrid.astro";
import { siteData, withBase } from "../utils/site-data";

const artifactCards = siteData.artifacts.map((artifact) => ({
  kicker: artifact.label.endsWith(".json") ? "Data artifact" : "Public document",
  title: artifact.label,
  body: `Public copy of ${artifact.source}.`,
  href: withBase(`/${artifact.site_path}`),
  source: artifact.source,
}));
---

<BaseLayout title="Artifacts | Agent Contracts Benchmark" description="Curated public artifacts for benchmark identity, results, and reproducibility.">
  <SiteChrome>
    <section class="page-intro">
      <p class="eyebrow">Artifacts</p>
      <h1>Every claim has a paper trail.</h1>
      <p>
        The goal is to connect the public narrative to the frozen benchmark definition and the canonical statistics artifact
        while keeping the public surface narrow and auditable.
      </p>
    </section>

    <SectionBlock
      id="artifact-set"
      eyebrow="Public artifact set"
      title="Public materials required to verify benchmark identity and canonical results."
    >
      <div class="artifact-toolbar">
        <div class="artifact-search"><label for="artifact-query">Find an artifact</label><input id="artifact-query" type="search" placeholder="Search by name, path, or document type…" aria-controls="artifact-list" /></div>
        <span class="artifact-count" role="status" aria-live="polite" data-artifact-count>{artifactCards.length} artifacts</span>
      </div>
      <div id="artifact-list"><ArtifactGrid items={artifactCards} /></div>
      <p class="artifact-empty" data-artifact-empty hidden>No matching artifacts. Try “oracle”, “results”, or “json”.</p>
    </SectionBlock>

    <SectionBlock
      id="repro"
      eyebrow="Reproducibility"
      title="Public site build and artifact-generation commands."
    >
      <div class="code-panel">
        <pre><code>uv sync --group dev --group site
uv run python scripts/build_site_data.py
npm ci --prefix site
npm run build --prefix site</code></pre>
      </div>
      <p class="section-note">
        The benchmark execution workflow itself remains in the repository docs and CLI entrypoints; this site only packages the public-facing benchmark companion.
      </p>
    </SectionBlock>

    <SectionBlock
      id="exclusions"
      eyebrow="Explicit exclusions"
      title="Materials excluded from the public navigation."
    >
      <div class="content-grid">
        <article class="story-card story-card-accent">
          <ul>
            <li>No <code>.tex</code> sources are linked from this site.</li>
            <li>Smoke-only directories are excluded from navigation.</li>
            <li>Exploratory reruns are excluded from navigation.</li>
            <li>Raw <code>trace.jsonl</code> execution dumps are excluded from navigation.</li>
          </ul>
        </article>
      </div>
    </SectionBlock>
    <script>
      const query = document.querySelector<HTMLInputElement>("#artifact-query");
      const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-artifact-card]"));
      const count = document.querySelector("[data-artifact-count]");
      const empty = document.querySelector("[data-artifact-empty]");
      query?.addEventListener("input", () => {
        const terms = query.value.trim().toLowerCase().split(/\s+/);
        let visible = 0;
        cards.forEach((card) => {
          const matches = terms.every((term) => card.dataset.search?.includes(term));
          card.hidden = !matches;
          if (matches) visible++;
        });
        if (count) count.textContent = `${visible} of ${cards.length} artifacts`;
        empty?.toggleAttribute("hidden", visible > 0);
      });
    </script>
  </SiteChrome>
</BaseLayout>
